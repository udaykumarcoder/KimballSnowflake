CREATE DATABASE ECOMMERCE19_DB;

USE DATABASE ECOMMERCE19_DB;

CREATE SCHEMA ECOMMERCE_SCHEMA;

USE SCHEMA ECOMMERCE_SCHEMA;

CREATE FILE FORMAT CSV_FORMAT
TYPE = 'CSV'
FIELD_DELIMITER = ','
SKIP_HEADER = 1;

CREATE STAGE RAW_STAGE 
FILE_FORMAT = CSV_FORMAT;

CREATE TABLE DIM_ORDER_INDICATORS
(
INDICATOR_SK NUMBER AUTOINCREMENT START 1 INCREMENT 1 PRIMARY KEY,
PAYMENT_METHOD VARCHAR(10),
SHIPPING_OPTION VARCHAR(10),
GIFT_WRAP_FLAG VARCHAR(2)
);

INSERT INTO DIM_ORDER_INDICATORS(PAYMENT_METHOD,SHIPPING_OPTION,GIFT_WRAP_FLAG)
SELECT  DISTINCT $7,$8, $9 FROM 
@RAW_STAGE/raw_orders.csv;


SELECT * FROM DIM_ORDER_INDICATORS
ORDER BY INDICATOR_SK;

CREATE TABLE FACT_SALES_TRANSACTIONS
(
ORDER_ID VARCHAR(20) PRIMARY KEY,
INDICATOR_SK NUMBER REFERENCES DIM_ORDER_INDICATORS(INDICATOR_SK),
USER_ID VARCHAR(20),
STORE_ID VARCHAR(20),
AMOUNT NUMBER(10,2),
TAX NUMBER(10,2)
);

INSERT INTO FACT_SALES_TRANSACTIONS(ORDER_ID,INDICATOR_SK,USER_ID,STORE_ID,AMOUNT,TAX)
SELECT  ORD.$1,
        O_IND.INDICATOR_SK,
        ORD.$3,
        ORD.$4,
        ORD.$5,
        ORD.$6
FROM @RAW_STAGE/raw_orders.csv ORD
INNER JOIN DIM_ORDER_INDICATORS O_IND 
ON O_IND.PAYMENT_METHOD=ORD.$7 AND 
    O_IND.SHIPPING_OPTION=ORD.$8 AND 
    O_IND.GIFT_WRAP_FLAG=ORD.$9;


SELECT  ORDER_ID,
        INDICATOR_SK,
        AMOUNT
FROM FACT_SALES_TRANSACTIONS
ORDER BY ORDER_ID;


CREATE TABLE FACT_INVENTORY_SNAPSHOT
(
SNAPSHOT_DATE DATE,
STORE_ID VARCHAR(20),
TOTAL_UNITS_HELD NUMBER,
TOTAL_INVENTORY_VAL NUMBER(10,2)
);

INSERT INTO FACT_INVENTORY_SNAPSHOT(SNAPSHOT_DATE,STORE_ID,TOTAL_UNITS_HELD,TOTAL_INVENTORY_VAL)
SELECT  $1,
        $2,
        SUM($4),
        SUM($4*$5)
FROM @RAW_STAGE/raw_inventory.csv
GROUP BY $1,$2;

SELECT * 
FROM FACT_INVENTORY_SNAPSHOT;


CREATE TABLE FACT_ORDER_FULFILLMENT
(
ORDER_ID VARCHAR(20),
ORDER_DATE DATE,
PICK_DATE DATE,
SHIP_DATE DATE,
DELIVERY_DATE DATE,
PICK_LAG_DAYS NUMBER,
SHIP_LAG_DAYS NUMBER,
DELIVERY_LAG_DAYS NUMBER,
TOTAL_FULFILLMENT_DAYS NUMBER
);

INSERT INTO FACT_ORDER_FULFILLMENT(ORDER_ID,ORDER_DATE,PICK_DATE,SHIP_DATE,DELIVERY_DATE,PICK_LAG_DAYS,SHIP_LAG_DAYS,DELIVERY_LAG_DAYS,TOTAL_FULFILLMENT_DAYS)
WITH FULFILMENT_CTE AS
(
SELECT  $1::VARCHAR(20) AS ORDER_ID,
        $2::DATE AS ORDER_DATE,
        $3::DATE AS PICK_DATE,
        NULLIF($4,'NULL')::DATE AS SHIP_DATE,
        NULLIF($5,'NULL')::DATE AS DELIVERY_DATE,
        DATEDIFF('DAY',$2,$3) AS PICK_LAG_DAYS,
        DATEDIFF('DAY',$3,NULLIF($4,'NULL')) AS SHIP_LAG_DAYS,
        DATEDIFF('DAY',NULLIF($4,'NULL'),NULLIF($5,'NULL')) AS DELIVERY_LAG_DAYS
FROM @RAW_STAGE/raw_fulfillment.csv
)
SELECT  ORDER_ID,
        ORDER_DATE,
        PICK_DATE,
        SHIP_DATE,
        DELIVERY_DATE,
        PICK_LAG_DAYS,
        SHIP_LAG_DAYS,
        DELIVERY_LAG_DAYS,
        (PICK_LAG_DAYS+SHIP_LAG_DAYS+DELIVERY_LAG_DAYS) AS TOTAL_FULFILLMENT_DAYS
FROM FULFILMENT_CTE;

SELECT  ORDER_ID,
        PICK_LAG_DAYS,
        SHIP_LAG_DAYS,
        DELIVERY_LAG_DAYS,
        TOTAL_FULFILLMENT_DAYS
FROM FACT_ORDER_FULFILLMENT
WHERE DELIVERY_LAG_DAYS IS NOT NULL;


SELECT  ORDER_ID,
        ORDER_DATE,
        CASE 
            WHEN DELIVERY_DATE IS NULL AND SHIP_DATE IS NOT NULL 
            THEN 'SHIPPED_NOT_DELIVERED'
            WHEN SHIP_DATE IS NULL
            THEN 'PICKED_NOT_SHIPPED'
        END AS CURRENT_STATUS
FROM FACT_ORDER_FULFILLMENT
WHERE DELIVERY_DATE IS NULL;

SELECT  DIM.PAYMENT_METHOD,
        COUNT(FCT.ORDER_ID) AS TOTAL_ORDERS,
        SUM(FCT.AMOUNT) AS TOTAL_REVENUE
FROM FACT_SALES_TRANSACTIONS FCT
INNER JOIN DIM_ORDER_INDICATORS DIM
ON FCT.INDICATOR_SK=DIM.INDICATOR_SK
GROUP BY DIM.PAYMENT_METHOD
ORDER BY PAYMENT_METHOD;
